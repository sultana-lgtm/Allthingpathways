# Everything below is optional. With none set, the app runs fully in demo mode.
PORT=3000
SHOP_NAME=PrintFlow Print Shop
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# QuickBooks Online (live mode needs the first four)
QBO_REALM_ID=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
QBO_ITEM_ID=1
QBO_SANDBOX=0

# Gmail inbox (live mode needs all three)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Stripe Terminal card reader (live mode needs both)
STRIPE_SECRET_KEY=
STRIPE_READER_ID=

# AI-written job summaries (falls back to a template without it)
ANTHROPIC_API_KEY=
